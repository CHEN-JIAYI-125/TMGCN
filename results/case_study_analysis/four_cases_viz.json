      },
      "utterances": [
        {
          "turn": 0,
          "utterance_id": 0,
          "node_index": -1,
          "speaker_id": 0,
          "gold_turn_name": "against",
          "text": "总不能受害者就必须一辈子活在阴影里，一直可怜兮兮的样子吧，不偷不抢，不拿过去的事吸引热度挣钱，挺好的",
